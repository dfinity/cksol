#!/usr/bin/env bash

set -euo pipefail

SOL_RPC_REV=92efe4eefc6b0209ee33440aa903383144016cf6
SOL_RPC_REPO=https://github.com/dfinity/sol-rpc-canister.git

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUTPUT="$ROOT_DIR/wasms/sol_rpc_canister-${SOL_RPC_REV:0:8}.wasm.gz"

if [ -f "$OUTPUT" ]; then
    echo "SOL RPC canister already built at $OUTPUT"
    exit 0
fi

CHECKOUT="$(mktemp -d)"
trap 'rm -rf "$CHECKOUT"' EXIT

git clone --quiet "$SOL_RPC_REPO" "$CHECKOUT"
git -C "$CHECKOUT" checkout --quiet "$SOL_RPC_REV"
(cd "$CHECKOUT" && ./scripts/docker-build)

mkdir -p "$ROOT_DIR/wasms"
cp "$CHECKOUT/wasms/sol_rpc_canister.wasm.gz" "$OUTPUT"
sha256sum "$OUTPUT"
